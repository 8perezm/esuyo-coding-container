{
  "name": "@esuyo/coding-container",
  "version": "1.0.4",
  "description": "CLI to build, publish and deploy SSH-accessible coding containers on k3s",
  "type": "module",
  "bin": {
    "coding-container": "src/index.js"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "docker",
    "kubernetes",
    "k3s",
    "ssh",
    "coding-container",
    "devcontainer"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "Dockerfile",
    "config.yaml"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0"
  }
}
