# Instance identity template. Copy to .env and uncomment to suit this checkout:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
# .env is gitignored and never committed; real environment wins over .env.

# Defaults (prod): global dir ~/.config/coding-container,
# SSH aliases coding-<project>, namespace coding.
#CODING_CONFIG_LEAF=coding-container
#CODING_SSH_PREFIX=coding-
#CODING_NAMESPACE=coding

# DEV example: global dir ~/.config/coding-container-dev,
# SSH aliases coding-dev-<project>, namespace coding-dev.
#CODING_CONFIG_LEAF=coding-container-dev
#CODING_SSH_PREFIX=coding-dev-
#CODING_NAMESPACE=coding-dev

# GUI server (single environment file: values moved here from web/.env).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
PORT=3001
# PROJECTS_FILE=web/projects.json
# ALLOWED_ORIGIN=
